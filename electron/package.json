{
  "name": "spektrafilm-electron",
  "version": "0.1.1",
  "private": true,
  "description": "SpektraOltra — Electron front-end with local Python engine",
  "author": "Oltra",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"vite\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && cross-env SPEKTRA_DEV_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "asia.ote.spektraoltra",
    "productName": "SpektraOltra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/spektra-engine",
        "to": "spektra-engine"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpektraOltra",
      "artifactName": "SpektraOltra-Setup-${version}.${ext}"
    }
  }
}