<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Spektrafilm</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.1</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>取景拍照需要访问相机：只拍摄 RAW（DNG），拍完直接入库显影。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>导出成片会保存到系统相册，方便直接在照片 App 里查看与分享。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>导入 RAW 需要读取相册里的原片：RAW+JPEG 成对照片和存放在 iCloud 的原片，只有按资源取回才能拿到 RAW 本体。</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/DSEG7Classic-Bold.ttf</string>
		<string>Fonts/SpecialElite-Regular.ttf</string>
		<string>Fonts/CourierPrime-Bold.ttf</string>
		<string>Fonts/Caveat-Bold.ttf</string>
		<string>Fonts/Kalam-Bold.ttf</string>
		<string>Fonts/Doto.ttf</string>
		<string>Fonts/Silkscreen-Regular.ttf</string>
		<string>Fonts/VT323-Regular.ttf</string>
		<string>Fonts/ZenDots-Regular.ttf</string>
		<string>Fonts/ShareTechMono-Regular.ttf</string>
		<string>Fonts/PressStart2P-Regular.ttf</string>
		<string>Fonts/LaBelleAurore.ttf</string>
		<string>Fonts/Yellowtail-Regular.ttf</string>
		<string>Fonts/Rye-Regular.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
